generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CasteCategory {
  SC
  ST
  OBC
  EWS
  GENERAL
}

enum EducationLevel {
  BELOW_10TH
  CLASS_10TH
  CLASS_12TH
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
}

enum Occupation {
  STUDENT
  FARMER
  ENTREPRENEUR
  SALARIED
  UNEMPLOYED
  OTHER
}

enum SchemeType {
  CENTRAL
  STATE
  PRIVATE
  NGO
}

enum SchemeCategory {
  EDUCATION
  AGRICULTURE
  HEALTHCARE
  HOUSING
  ENTREPRENEURSHIP
  WOMEN
  DISABILITY
  SENIOR_CITIZEN
  OTHER
}

enum ApplicationMode {
  ONLINE
  OFFLINE
  BOTH
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
}

enum DocumentCategory {
  IDENTITY
  ADDRESS
  INCOME
  CASTE
  EDUCATION
  BANK
  AGRICULTURAL
  BUSINESS
  DISABILITY
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum DocumentStatus {
  NOT_STARTED
  INCOMPLETE
  COMPLETE
}

// Models

model User {
  id              String    @id @default(uuid())
  phone           String    @unique
  email           String?   @unique
  password        String
  fullName        String
  dateOfBirth     DateTime
  gender          Gender
  profilePicture  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userProfile     UserProfile?
  schemeMatches   UserSchemeMatch[]
  applications    Application[]
  userDocuments   UserDocument[]

  @@map("users")
  @@index([phone])
}

model UserProfile {
  id                          String          @id @default(uuid())
  userId                      String          @unique
  user                        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  casteCategory               CasteCategory
  annualIncome                Int
  state                       String
  district                    String
  educationLevel              EducationLevel
  occupation                  Occupation
  disabilityStatus            Boolean
  disabilityType              String?
  bankAccount                 String?         // Encrypted
  bankIFSC                    String?
  profileCompletionPercentage Int             @default(0)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@map("user_profiles")
}

model Scheme {
  id                      String          @id @default(uuid())
  schemeName              String
  schemeType              SchemeType
  ministryDepartment      String
  category                SchemeCategory
  targetBeneficiary       String          @db.Text
  eligibilityCriteria     Json
  financialBenefit        String          @db.Text
  benefitAmount           Int?
  requiredDocuments       String[]
  applicationDeadline     DateTime?
  applicationMode         ApplicationMode
  officialLink            String
  guidelinesPDF           String?
  state                   String?
  activeStatus            Boolean         @default(true)
  lastVerified            DateTime
  applicationFormTemplate Json?           // Template defining the form structure
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  schemeMatches           UserSchemeMatch[]
  applications            Application[]

  @@map("schemes")
  @@index([schemeName])
}

model UserSchemeMatch {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemeId            String
  scheme              Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  matchScore          Int      // 0-100
  eligibilityBreakdown Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, schemeId])
  @@map("user_scheme_matches")
}

model Application {
  id                       String            @id @default(uuid())
  userId                   String
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemeId                 String
  scheme                   Scheme            @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  status                   ApplicationStatus @default(DRAFT)
  documentStatus           DocumentStatus    @default(NOT_STARTED)
  documentChecklistData    Json?             // { required: [], uploaded: [], missing: [] }
  formData                 Json?             // Previously applicationData
  submittedAt              DateTime?
  lastUpdatedAt            DateTime          @updatedAt
  rejectionReason          String?           @db.Text
  reviewedBy               String?           // admin userId
  reviewedAt               DateTime?
  approvalDate             DateTime?
  disbursementAmount       Decimal?          @db.Decimal(12, 2)
  disbursementDate         DateTime?
  disbursementReferenceId  String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  applicationDocuments     ApplicationDocument[]
  history                  ApplicationHistory[]

  @@map("applications")
  @@index([userId])
  @@index([status])
}

model MasterDocument {
  id                       String           @id @default(uuid())
  documentName             String           @unique
  documentCode             String           @unique
  category                 DocumentCategory
  description              String?          @db.Text
  isCommon                 Boolean          @default(false)
  procurementGuideOnline   Json?            // { steps: [], processingTime: "", fees: "" }
  procurementGuideOffline  Json?            // { steps: [], officeType: "", processingTime: "", fees: "" }
  stateSpecific            Boolean          @default(false)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  userDocuments            UserDocument[]
  officeAddresses          DocumentOfficeAddress[]

  @@map("documents")
}

model DocumentOfficeAddress {
  id            String         @id @default(uuid())
  documentId    String
  document      MasterDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  state         String
  district      String?
  officeType    String
  officeName    String
  address       String         @db.Text
  contactNumber String?
  officeHours   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([documentId, state, district])
  @@map("document_office_addresses")
}

model UserDocument {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId        String
  document          MasterDocument     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  fileName          String
  fileType          String
  fileSize          Int
  fileUrl           String
  uploadedAt        DateTime           @default(now())
  verificationStatus VerificationStatus @default(PENDING)
  verifiedBy        String?
  verifiedAt        DateTime?
  expiryDate        DateTime?
  metadata          Json?              // OCR data, etc.
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  applicationDocuments ApplicationDocument[]

  @@unique([userId, documentId])
  @@map("user_documents")
}

model ApplicationDocument {
  id             String       @id @default(uuid())
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userDocumentId String
  userDocument   UserDocument @relation(fields: [userDocumentId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([applicationId, userDocumentId])
  @@map("application_documents")
}

model ApplicationHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  changedBy     String            // userId or "SYSTEM"
  comment       String?           @db.Text
  createdAt     DateTime          @default(now())

  @@index([applicationId])
  @@map("application_history")
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_verifications")
  @@index([phone])
}
