// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id            String    @id @default(cuid())
  mobile        String    @unique
  mobileVerified DateTime?
  aadhaarHash   String?   @unique
  name          String
  email         String?
  dateOfBirth   DateTime
  gender        Gender
  category      Category
  state         String
  district      String?
  pincode       String?
  annualIncome  Int?
  education     Education?
  occupation    String?
  disability    Boolean   @default(false)
  disabilityType String?
  
  // Relations
  familyMembers          FamilyMember[]
  applications           Application[]
  documents              Document[]
  profile                UserProfile?
  premiumTransactions    PremiumTransaction[]
  notificationPreference NotificationPreference?
  notifications          Notification[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([mobile])
  @@index([state])
  @@index([category])
  @@map("users")
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  maritalStatus   String?
  religion        String?
  bankAccount     String?
  ifscCode        String?
  panNumber       String?
  
  consentData     Boolean  @default(false)
  consentMarketing Boolean @default(false)

  // Premium Tracking
  isPremium       Boolean  @default(false)
  premiumExpiresAt DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_profiles")
}

model FamilyMember {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  relationship  String
  dateOfBirth   DateTime
  gender        Gender
  education     Education?
  occupation    String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
}

// Scheme Management
model Scheme {
  id                String   @id @default(cuid())
  schemeId          String   @unique
  name              String
  nameHindi         String?
  description       String   @db.Text
  ministry          String
  schemeType        SchemeType
  category          SchemeCategory
  
  // Eligibility
  eligibilityCriteria Json
  minAge            Int?
  maxAge            Int?
  genderEligible    Gender?
  categoryEligible  Category[]
  stateEligible     String[]
  incomeLimit       Int?
  
  // Benefits
  benefitType       String
  benefitAmount     Int?
  benefitDescription String @db.Text
  
  // Application
  requiredDocuments String[]
  applicationLink   String
  deadline          DateTime?
  isRolling         Boolean  @default(false)
  
  // Metadata
  successRate       Float?
  totalBeneficiaries Int?
  isActive          Boolean  @default(true)
  
  applications      Application[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([schemeType])
  @@index([category])
  @@index([isActive])
}

// Application Management
model Application {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemeId        String
  scheme          Scheme   @relation(fields: [schemeId], references: [id])
  
  status          ApplicationStatus @default(DRAFT)
  eligibilityScore Float?
  
  formData        Json?
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  
  trackingId      String?  @unique
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  premiumApplication ApplicationPremium?
  
  @@index([userId])
  @@index([schemeId])
  @@index([status])
}

// Document Management
model Document {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  documentType    String
  documentName    String
  fileUrl         String
  fileSize        Int
  mimeType        String
  
  status          String   @default("ACTIVE") // ACTIVE, EXPIRED, EXPIRING_SOON
  isVerified      Boolean  @default(false)
  verifiedAt      DateTime?
  expiryDate      DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([documentType])
}

// Enums
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Category {
  GENERAL
  SC
  ST
  OBC
  EWS
}

enum Education {
  BELOW_10TH
  CLASS_10TH
  CLASS_12TH
  UNDERGRADUATE
  GRADUATE
  POSTGRADUATE
  DOCTORATE
}

enum SchemeType {
  CENTRAL
  STATE
  PRIVATE
  NGO
}

enum SchemeCategory {
  EDUCATION
  AGRICULTURE
  HEALTHCARE
  HOUSING
  ENTREPRENEURSHIP
  WOMEN_CHILD
  SENIOR_CITIZEN
  DISABILITY
  EMPLOYMENT
  SKILL_DEVELOPMENT
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
}

// Phase 4: Premium Transactions
model PremiumTransaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount          Float
  currency        String   @default("INR")
  status          PaymentStatus @default(PENDING)
  provider        String   @default("RAZORPAY")
  orderId         String?  @unique
  paymentId       String?  @unique
  signature       String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// Phase 4: Application Premium Services
model ApplicationPremium {
  id              String   @id @default(cuid())
  applicationId   String   @unique
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  serviceType     String   // e.g., "FAST_TRACK", "AI_REVIEW"
  status          String   @default("PENDING")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Phase 4: Notification Preferences
model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  smsEnabled      Boolean  @default(true)
  emailEnabled    Boolean  @default(true)
  whatsappEnabled Boolean  @default(false)
  pushEnabled     Boolean  @default(true)
  
  updatedAt       DateTime @updatedAt
}

// Phase 4: Notifications
model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  message     String
  type        String   // e.g., "DEADLINE", "EXPIRY", "MATCH", "SYSTEM"
  link        String?
  isRead      Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([isRead])
}

// Enums Extensions
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
